{
  "name": "dev-config-db",
  "version": "0.1.0",
  "private": true,
  "description": "The MySQL-family extension of @gokayo43/dev-config: one reusable workflow, for the two legacy repos whose database is MariaDB or MySQL 8.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokayo43/dev-config-db.git"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "typecheck": "bun check --no-script",
    "knip": "knip",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "test": "bun test",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@gokayo43/dev-config": "github:gokayo43/dev-config#5c95d7d005af11c48ad74e63188d29d36e2acd59",
    "@types/bun": "1.4.2",
    "drizzle-orm": "0.45.2",
    "knip": "6.35.1",
    "lefthook": "2.1.12",
    "mysql2": "3.24.4",
    "oxfmt": "0.67.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006"
  },
  "packageManager": "bun@1.4.4",
  "lifecycle": "dev"
}
