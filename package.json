{
  "name": "dev-config-db",
  "version": "0.1.0",
  "private": true,
  "description": "The MySQL-family extension of @gokayo43/dev-config: one reusable workflow, for the two legacy repos whose database is MariaDB or MySQL 8.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokayo43/dev-config-db.git"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "test": "bun test",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@gokayo43/dev-config": "github:gokayo43/dev-config#d1f756aacca92fd99a66ba3370f290c41cb36a22",
    "@types/bun": "1.4.1",
    "drizzle-orm": "0.45.2",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "mysql2": "3.24.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "lifecycle": "dev"
}
