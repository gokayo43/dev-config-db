{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@gokayo43/dev-config/oxlint.base.json"],
  "env": { "node": true, "es2024": true },
  "ignorePatterns": ["node_modules/**", ".github/actions/db-serving/ramp.js"],
  "overrides": [
    {
      "files": [
        ".github/actions/_lib/annotations.ts",
        ".github/actions/db-replay/database.ts",
        ".github/actions/db-server/server.ts",
        ".github/actions/db-serving/boot.ts",
        ".github/actions/db-serving/probe.ts",
        ".github/actions/db-serving/ramp.ts"
      ],
      "rules": {
        // `annotations.ts` is this repo's `env.ts` under another name:
        // `inputs()` and `required()` are the choke point the rule asks for, and
        // both throw on a value they cannot read rather than defaulting. A gate
        // runs from an action's own checkout with no install above it, so the
        // module a consuming repo would import cannot be reached from here
        // anyway. The other five forward the environment they were started with
        // to a child process — `{ ...process.env, … }` for a docker command, an
        // app, a probe or a k6 run — which reads no variable and has none to
        // validate. Named one file at a time so a seventh reader fails rather
        // than joining a glob, which is how dev-config answers the same rule in
        // its own tree.
        "anti-slop/no-env-access": "off"
      }
    },
    {
      "files": [
        ".github/actions/_lib/foreign.ts",
        ".github/actions/db-replay/database.ts",
        ".github/actions/db-serving/route-coverage.ts",
        "tests/workflow.ts",
        "tests/wrapper-inputs.test.ts"
      ],
      "rules": {
        // One of the base's own rules, off for these five files and nowhere
        // else. The rule exists to push parsing to the boundary; these ARE the
        // boundary. `foreign.ts` is where a document nobody here wrote gets
        // narrowed, and the others walk one before they can reach it — a YAML
        // node, a recursive descent, a row a driver answered `any` for, a
        // route-log payload an app the gate does not own serves. A sixth file
        // wanting this is a decision, which is why the list is written out
        // rather than globbed.
        "anti-slop/no-unknown-parameters": "off"
      }
    }
  ]
}
